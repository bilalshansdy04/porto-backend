# TiDB Database Configuration
# TiDB menggunakan protokol yang sama dengan MySQL (MySQL-compatible)
# Secara default TiDB menggunakan port 4000

# Contoh untuk TiDB Local (jika menginstall via TiUP atau Docker)
DB_HOST=127.0.0.1
DB_PORT=4000
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=porto_db

# =========================================================================
# Contoh untuk TiDB Cloud (Serverless)
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USERNAME=xxxxxx.root
# DB_PASSWORD=your_tidb_cloud_password
# DB_DATABASE=porto_db
# =========================================================================